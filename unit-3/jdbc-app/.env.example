# ExpenseSync JDBC Database Configuration
# Copy this file to .env or pass system properties

# Set DB_TYPE to 'h2' for zero-setup standalone run, or 'mysql' for local MySQL
DB_TYPE=h2

# MySQL Configuration (used if DB_TYPE=mysql)
DB_URL=jdbc:mysql://localhost:3306/expensesync_db?useSSL=false&allowPublicKeyRetrieval=true
DB_USER=root
DB_PASSWORD=root
